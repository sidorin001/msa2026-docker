# Local demonstration only: replace all CHANGE_ME passwords before use.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
DB1_NAME=groups_db
DB2_NAME=items_db
DB1_APP_USER=groups_app
DB2_APP_USER=items_app
DB1_APP_PASSWORD=CHANGE_ME_groups_app
DB2_APP_PASSWORD=CHANGE_ME_items_app
DB1_ADMIN_PASSWORD=CHANGE_ME_groups_admin
DB2_ADMIN_PASSWORD=CHANGE_ME_items_admin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin
SERVICE2_BASE_URL=http://gateway:80
HTTP_CONNECT_TIMEOUT_MS=2000
HTTP_READ_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_SECONDS=2
DB_STATEMENT_TIMEOUT_MS=3000
